// Базовый oxlint-конфиг монорепозитория. oxlint ищет `.oxlintrc.json`,
// поднимаясь от текущего каталога вверх по дереву — пакет без своего файла
// молча наследует этот; `packages/ui` и `packages/app` держат свой,
// расширяющий этот через `extends`, и добавляют туда правила адгезии
// дизайн-системы (см. комментарий в их `.oxlintrc.json`).
{
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["import", "typescript", "unicorn"],
  // `no-undef` не входит ни в одну включённую категорию, и его отсутствие
  // стоило реального прогона: в `apps/mobile/scripts/android-smoke.mjs`
  // вызов `readControlTask(...)` попал в скрипт, а само объявление — нет
  // (тихий no-op текстовой замены). `node --check` это пропускает: синтаксис
  // корректен. Прогон на эмуляторе дошёл до конца сценария и упал
  // `ReferenceError` через семнадцать минут. Правило ловит это за секунду.
  //
  // Проверено внесением нарушения: вызов несуществующей функции краснит
  // линт. Без правила краснело только косвенно — через «объявлена и не
  // используется», то есть ровно в том случае, которого в этом дефекте не
  // было.
  "rules": {
    "no-undef": "error"
  },
  // `node`/`browser` добавлены вместе с `no-undef`: без них правило считает
  // неопределёнными `process`, `console`, `window`, `localStorage` — то есть
  // ровно то, чем этот репозиторий пользуется законно и повсеместно.
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  // `src-tauri/vendor/**` — вендоренные ЧУЖИЕ крейты, подключённые через
  // `[patch.crates-io]` (сейчас `tauri-plugin-notification` 2.4.0, ADR-0008,
  // дополнение от 2026-09-04). Это дословная копия апстрима с одним точечным
  // патчем; линтовать чужой минифицированный `api-iife.js` нашими правилами
  // бессмысленно — они не про наш код, а «исправить» их значило бы разойтись
  // с апстримом там, где diff обязан оставаться минимальным.
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/src-tauri/vendor/**"]
}
