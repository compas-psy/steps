{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "."
  },
  // `dev`/`e2e`/`vite.config.ts`/`playwright.config.ts` добавлены для E03
  // «харнесс a11y и визрегрессии» (тот же список, что `apps/web/tsconfig.json`
  // уже держит для своего `e2e`/`playwright.config.ts`) — без этого
