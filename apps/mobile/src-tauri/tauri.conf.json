{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ШАГИ",
  "mainBinaryName": "shagi-mobile",
  "version": "0.1.0",
  "identifier": "ru.cmpas.shagi",
  "build": {
    "beforeDevCommand": "pnpm run dev:vite",
    "devUrl": "http://localhost:5184",
    "beforeBuildCommand": "pnpm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ШАГИ"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "publisher": "СИМПАС",
    "copyright": "СИМПАС",
    "category": "Productivity",
    "android": {
      "minSdkVersion": 26
    }
  }
}
