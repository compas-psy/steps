{
  "name": "shagi",
  "version": "0.1.0",
  "private": true,
  "description": "ШАГИ — personal task manager, экосистема СИМПАС. Local-first, offline-first, ru-RU.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r exec vitest run --exclude \"**/*.integration.test.*\"",
    "test:integration": "pnpm -r exec vitest run --passWithNoTests \"integration.test\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/check-i18n-catalog.mjs",
    "check:log-hygiene": "node scripts/check-log-hygiene.mjs",
    "check:signing-secrets": "node scripts/check-signing-secrets.mjs",
    "check:licenses": "node scripts/check-license-allowlist.mjs"
  },
  "devDependencies": {
    "oxlint": "1.80.0",
    "oxlint-plugin-eslint": "1.80.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
